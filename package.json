{
  "name": "universal-converter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "A free, login-free file converter that runs entirely in your browser. No uploads, no server, no tracking.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:app": "vite build --mode capacitor",
    "android": "npm run build:app && npx cap sync android && npx cap open android",
    "electron:build": "npm run build:app && electron-builder --win",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.munnx.convertor",
    "productName": "MunnX Convertor",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "MunnX Convertor"
    }
  },
  "dependencies": {
    "@bunnio/rembg-web": "^1.0.2",
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "@neslinesli93/qpdf-wasm": "^0.3.0",
    "@nuintun/qrcode": "^5.0.3",
    "docx": "^9.0.2",
    "exifr": "^7.1.3",
    "jspdf": "^2.5.2",
    "jszip": "^3.10.1",
    "mammoth": "^1.8.0",
    "marked": "^14.1.2",
    "onnxruntime-web": "^1.27.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.7.76",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.2.10",
    "tesseract.js": "^5.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@ffmpeg/core": "^0.12.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.9"
  }
}
